# Line endings pinned per file type: scripts that run in Linux containers stay LF on Windows checkouts, Windows
# command scripts stay CRLF.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
